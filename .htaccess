RewriteEngine On

# Chuyển URL gõ trực tiếp có .php sang URL sạch trong lúc phát triển.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
RewriteRule ^ /%1 [R=302,L,NE]

# URL sạch vẫn chạy các file PHP tương ứng ở phía server.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
